%% Northbridge Skills Institute — Task 2 Stage 1 IR and business continuity coordination
%% Functional roles are proposed governance roles, not evidence of additional employees.
flowchart LR
  classDef lead fill:#163b5c,stroke:#f0b45b,color:#f4f8fb,stroke-width:2px;
  classDef security fill:#0b1f33,stroke:#4cc9c0,color:#f4f8fb,stroke-width:2px;
  classDef business fill:#123b4a,stroke:#4cc9c0,color:#f4f8fb,stroke-width:2px;
  classDef decision fill:#3b2b16,stroke:#f0b45b,color:#fff7e6,stroke-width:2px;
  classDef validation fill:#34495e,stroke:#b7c9d6,color:#f4f8fb,stroke-width:2px;
  classDef note fill:#e8f1f5,stroke:#5b7285,color:#10202f,stroke-width:1px;

  IR["Incident Response Lead<br/>Declare, coordinate, document,<br/>recommend containment and escalation"]:::lead
  SA["Security Analysis<br/>Evidence, uncertainty, severity,<br/>security validation"]:::security
  IT["Technical Operations<br/>Dependencies, approved execution,<br/>availability and recovery work"]:::security
  BC["Business Continuity Coordinator<br/>Coordinates authorised arrangements;<br/>predefined low-risk preparation within delegation"]:::business
  ACAD["Academic Operations /<br/>Business Service Owner<br/>Approves examination delivery within parameters;<br/>learner impact"]:::business
  MGMT["Senior Management approval<br/>Material continuity activation, risk acceptance,<br/>extraordinary resources, and Critical decisions"]:::decision
  RSV["Recovery security validation<br/>Security, integrity, controlled test,<br/>and monitoring conditions"]:::validation
  BA["Business acceptance<br/>Service function, learner impact,<br/>and approved return to service"]:::business
  SIT["Shared situation report<br/>Confirmed status, uncertainty,<br/>restrictions, options, next decision"]:::note
  LEGEND["Legend<br/>Navy = incident leadership<br/>Blue = security/technical functions<br/>Teal = continuity/business functions<br/>Gold = approval; gray = validation/reporting<br/>BCC is a proposed functional assignment;<br/>management assigns a deputy/alternate"]:::note

  IR --> SA
  IR --> IT
  IR <--> SIT
  SA --> RSV
  IT --> RSV
  BC --> ACAD
  ACAD --> MGMT
  IR --> MGMT
  BC --> MGMT
  MGMT --> RSV
  RSV --> BA
  ACAD --> BA
  BA --> MGMT
  SIT --> SA
  SIT --> BC
  SIT --> ACAD
  LEGEND -.-> IR
