%% Northbridge Skills Institute — Task 2 Stage 1 incident declaration and activation
%% Proposed governance flow; no action in this diagram is represented as completed.
flowchart TD
  classDef start fill:#163b5c,stroke:#f0b45b,color:#f4f8fb,stroke-width:2px;
  classDef action fill:#0b1f33,stroke:#4cc9c0,color:#f4f8fb,stroke-width:2px;
  classDef decision fill:#123b4a,stroke:#4cc9c0,color:#f4f8fb,stroke-width:2px;
  classDef escalation fill:#3b2b16,stroke:#f0b45b,color:#fff7e6,stroke-width:2px;
  classDef note fill:#e8f1f5,stroke:#5b7285,color:#10202f,stroke-width:1px;

  START["Detection or report<br/>User, service desk, EDR, logs, provider, or phone"]:::start
  CHANNEL{"Approved channel available<br/>and sufficiently trusted?"}:::decision
  ALT["Use approved alternate channel<br/>or controlled offline record<br/>Record WAT time and source"]:::action
  TRIAGE["Initial triage<br/>Preserve report; identify immediate safety,<br/>service, data, and evidence concerns"]:::action
  VALIDATE{"Credible security or policy event<br/>with material or potential impact?"}:::decision
  TRACK["Record and route as an event<br/>Continue monitoring or close with rationale"]:::note
  DECLARE["Declare incident<br/>Create proposed ID; record facts,<br/>assets, uncertainty, and evidence references"]:::action
  SEV["Assign initial severity<br/>Use Task 1 criteria; do not infer final scope"]:::action
  HIGH["Northbridge example<br/>High — provisional at 08:45 WAT Day 0"]:::escalation
  ACTIVATE["Activate appropriate response capability<br/>Incident Lead coordinates available IT/security<br/>and requests business or specialist support as needed"]:::action
  NOTIFY["Notify required roles<br/>Management, service owner, continuity,<br/>privacy/legal, communications as applicable"]:::action
  REVIEW["Reassess and document<br/>After material evidence, impact change,<br/>before restoration, and at closure"]:::action
  LEGEND["Legend<br/>Gold = entry or escalation marker<br/>Teal = decision or proposed action<br/>Dashed path = alternate or review route<br/>All actions are proposed, not completed"]:::note

  START --> CHANNEL
  CHANNEL -->|No| ALT --> TRIAGE
  CHANNEL -->|Yes| TRIAGE
  TRIAGE --> VALIDATE
  VALIDATE -->|No| TRACK
  VALIDATE -->|Yes| DECLARE --> SEV
  SEV -.-> HIGH
  SEV --> ACTIVATE --> NOTIFY --> REVIEW
  REVIEW -.-> VALIDATE
  LEGEND -.-> DECLARE
