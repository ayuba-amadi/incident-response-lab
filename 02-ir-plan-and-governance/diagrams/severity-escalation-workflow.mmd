%% Northbridge Skills Institute — Task 2 Stage 1 severity escalation workflow
%% Consistent with the approved Task 1 qualitative severity criteria.
flowchart TD
  classDef assess fill:#0b1f33,stroke:#4cc9c0,color:#f4f8fb,stroke-width:2px;
  classDef critical fill:#4a1f2a,stroke:#f07b8b,color:#fff4f6,stroke-width:2px;
  classDef high fill:#3b2b16,stroke:#f0b45b,color:#fff7e6,stroke-width:2px;
  classDef medium fill:#123b4a,stroke:#4cc9c0,color:#f4f8fb,stroke-width:2px;
  classDef low fill:#34495e,stroke:#b7c9d6,color:#f4f8fb,stroke-width:2px;
  classDef note fill:#e8f1f5,stroke:#5b7285,color:#10202f,stroke-width:1px;

  START["Current assessment or new evidence<br/>Reassess scope, impact, urgency,<br/>recoverability, and resource needs"]:::assess
  C1{"Severe or imminent institution-wide disruption,<br/>essential function cannot be delivered safely,<br/>broad compromise/disclosure, persistent control,<br/>or viable recovery lost?"}:::assess
  C2{"Material critical-service or multi-asset impact,<br/>suspected compromise, time-critical examination,<br/>privileged/recovery concern, or significant uncertainty?"}:::assess
  C3{"Localised impact with essential operations continuing<br/>and a credible recovery path?"}:::assess
  CRIT["CRITICAL<br/>Senior management / Executive Sponsor<br/>Immediate full available mobilisation"]:::critical
  HIGH["HIGH<br/>Incident Response Lead directs<br/>Management notified rapidly<br/>Northbridge: provisional position at 08:45"]:::high
  MED["MEDIUM<br/>Incident Response Lead with service owner<br/>Prompt proportionate response"]:::medium
  LOW["LOW<br/>Operational owner / Incident Lead<br/>Standard documented workflow"]:::low
  UP["Escalate or reduce only when<br/>new evidence or validated business impact<br/>supports the change"]:::note
  LEGEND["Legend<br/>Solid path = assessment decision<br/>Dashed arrows = later reassessment pathway<br/>No severity change is implied without evidence or<br/>validated operational impact"]:::note

  START --> C1
  C1 -->|Yes| CRIT
  C1 -->|No| C2
  C2 -->|Yes| HIGH
  C2 -->|No| C3
  C3 -->|Yes| MED
  C3 -->|No| LOW
  LOW -.->|Material impact or uncertainty| MED
  MED -.->|Critical service or multi-asset impact| HIGH
  HIGH -.->|Severe scope, loss, or consequence| CRIT
  CRIT -.->|Validated reduction| HIGH
  UP -.-> C1
  LEGEND -.-> HIGH
