%% Northbridge Skills Institute — Stage 1 investigative relationship model
%% Confirmed architecture, recorded observations, and hypotheses are separated.
flowchart LR
  classDef asset fill:#0b1f33,stroke:#4cc9c0,color:#f4f8fb,stroke-width:2px;
  classDef observation fill:#34495e,stroke:#b7c9d6,color:#f4f8fb,stroke-width:1.5px;
  classDef hypothesis fill:#3b2b16,stroke:#f0b45b,color:#fff7e6,stroke-width:2px,stroke-dasharray: 6 4;
  classDef legend fill:#e8f1f5,stroke:#5b7285,color:#10202f,stroke-width:1px;

  subgraph ASSETS["Systems, identities, and destination"]
    FIN["FIN-PC07<br/>Finance workstation"]:::asset
    M365["Microsoft 365 identity and email<br/>Finance officer account"]:::asset
    SVC["svc_backup<br/>Privileged account"]:::asset
    FS01["FS01<br/>Shared file server"]:::asset
    BAK01["BAK01<br/>Network backup repository"]:::asset
    LMS01["LMS01<br/>Learning portal"]:::asset
    CLOUD["Unfamiliar cloud-storage<br/>destination"]:::asset
  end

  subgraph OBS["Recorded observations"]
    O1["O1 / E01<br/>Payroll attachment opened"]:::observation
    O2["O2 / E02<br/>Unfamiliar IP/new-device sign-in"]:::observation
    O3["O3 / E03<br/>svc_backup remote admin logons<br/>outside normal schedule"]:::observation
    O4["O4 / E04<br/>FIN-PC07 uploaded 1.2 GB HTTPS"]:::observation
    O5["O5 / E05<br/>FS01/LMS01 jobs reported successful<br/>Destination and recovery unverified"]:::observation
    O6["O6 / E06<br/>Mass file changes; .locked files<br/>and ransom note"]:::observation
    O7["O7 / E07<br/>Learners cannot open materials<br/>or submit assessments"]:::observation
    O8["O8 / E08<br/>FS01 contact list inaccessible"]:::observation
  end

  subgraph HYP["Investigation hypotheses — unverified"]
    H1["H1 / E01↔E02<br/>Possible attachment/identity link"]:::hypothesis
    H2["H2 / E03↔E06<br/>Possible privileged/file-change link"]:::hypothesis
    H3["H3 / E06↔E07<br/>Possible FS01 dependency link"]:::hypothesis
  end

  FS01 -->|Confirmed dependency| LMS01

  O1 -->|Recorded observation| FIN
  O2 -->|Recorded observation| M365
  O3 -->|Logons| SVC
  O3 -->|Logons| FS01
  O3 -->|Logons| BAK01
  O4 -->|Source| FIN
  O4 -->|Destination only| CLOUD
  O5 -->|Reported job| FS01
  O5 -->|Reported job| LMS01
  O6 -->|File changes| FIN
  O6 -->|.locked files/ransom note| FS01
  O7 -->|Learner impact| LMS01
  O8 -->|Access issue| FS01

  O1 -.-> H1
  O2 -.-> H1
  O3 -.-> H2
  O6 -.-> H2
  O6 -.-> H3
  O7 -.-> H3

  LEGEND["Legend<br/>Navy = assets; blue-gray = recorded observations<br/>Amber dashed = unverified hypotheses<br/>E05 does not identify BAK01 as destination<br/>No edge proves causation, attacker identity, or data theft"]:::legend
  LEGEND -.-> FIN
